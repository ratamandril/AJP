{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/anki-json-protocol/schemas/structural-change-report.schema.json",
  "title": "AJP Structural Change Report 0.1.0",
  "type": "object",
  "required": ["protocol", "report_version", "plan_id", "generated_at", "active_profile", "api_version", "result", "writes_attempted", "source_type", "target_type", "target_deck", "target_deck_exists", "target_model_exists", "target_model_reused", "structural_diff", "notes", "policy", "limitations"],
  "properties": {
    "protocol": {"const": "anki-json-structural-change-report"},
    "report_version": {"const": "0.1.0"},
    "plan_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "active_profile": {"type": "string"},
    "api_version": {"type": "integer"},
    "result": {"type": "string"},
    "writes_attempted": {"type": "boolean"},
    "mode": {"enum": ["plan", "apply"]},
    "source_type": {"type": "string"},
    "target_type": {"type": "string"},
    "target_deck": {"type": "string"},
    "target_deck_exists": {"type": "boolean"},
    "target_model_exists": {"type": "boolean"},
    "target_model_reused": {"type": "boolean"},
    "structural_diff": {
      "type": "object",
      "required": ["kind_changed", "fields_added", "fields_removed", "field_order_changed", "source_field_order", "target_field_order", "templates_added", "templates_removed", "templates_changed", "css_changed", "source_template_count", "target_template_count", "strategy"],
      "properties": {
        "kind_changed": {"type": "boolean"},
        "fields_added": {"type": "array", "items": {"type": "string"}},
        "fields_removed": {"type": "array", "items": {"type": "string"}},
        "field_order_changed": {"type": "boolean"},
        "source_field_order": {"type": "array", "items": {"type": "string"}},
        "target_field_order": {"type": "array", "items": {"type": "string"}},
        "templates_added": {"type": "array", "items": {"type": "string"}},
        "templates_removed": {"type": "array", "items": {"type": "string"}},
        "templates_changed": {"type": "array", "items": {"type": "object", "required": ["name", "changed_sides"], "properties": {"name": {"type": "string"}, "changed_sides": {"type": "array", "items": {"enum": ["question", "answer"]}}}, "additionalProperties": false}},
        "css_changed": {"type": "boolean"},
        "source_template_count": {"type": "integer"},
        "target_template_count": {"type": "integer"},
        "strategy": {"type": "string"}
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "policy": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "source_preservation_checks": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "target_notes_verified": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "migration_executor": {"type": "object"},
    "migration_executor_stdout": {"type": "string"},
    "migration_executor_stderr": {"type": "string"},
    "migration_executor_exit_code": {"type": "integer"}
  },
  "additionalProperties": true
}
